[
    {
        // Barra completa nos demais monitores.
        "output": ["!DP-1", "*"],
        "include": ["~/.config/waybar/common.jsonc"]
    },
    {
        // Monitor VGA 1024x768: mantém relógio e agentes, sem os controles do sistema.
        "output": "DP-1",
        "include": ["~/.config/waybar/common.jsonc"],
        "modules-right": ["group/agents"]
    }
]
