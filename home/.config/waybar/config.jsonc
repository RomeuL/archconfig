{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/codex", "clock", "custom/claude"],
    "modules-right": ["custom/screenshot", "tray", "pulseaudio", "backlight", "network", "bluetooth", "cpu", "memory", "power-profiles-daemon", "battery", "custom/power"],

    "hyprland/workspaces": {
        // Numeração em kanji, como no Cyber-Arch (z e x continuam com o nome)
        "format": "{icon}",
        "format-icons": {
            "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
            "z": "z", "x": "x",
            "default": "·"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "persistent-workspaces": { "eDP-1": [1, 2, 3, 4, 5] }
    },
    // Status do Claude Code e do Codex: um único agents.py (daemon) grava o estado e cada módulo só faz tail -F
    "custom/codex": {
        "exec": "sh -c '~/.config/waybar/scripts/agents.py daemon & exec tail -n1 -F ~/.cache/agent-status/waybar-codex.json 2>/dev/null'",
        "return-type": "json",
        "escape": false,
        "on-click": "~/.config/waybar/scripts/agents.py focus codex"
    },
    "custom/claude": {
        "exec": "sh -c '~/.config/waybar/scripts/agents.py daemon & exec tail -n1 -F ~/.cache/agent-status/waybar-claude.json 2>/dev/null'",
        "return-type": "json",
        "escape": false,
        "on-click": "~/.config/waybar/scripts/agents.py focus claude"
    },
    "hyprland/language": {
        "format": "⌨ {short}"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d de %B de %Y  %H:%M}",
        "locale": "pt_BR.UTF-8",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#7aa2f7'><b><u>{}</u></b></span>"
            }
        }
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Perfil de energia: {profile}\nClique para alternar",
        "tooltip": true,
        "format-icons": {
            "default": "󰊚",
            "performance": "󰓅",
            "balanced": "󰊚",
            "power-saver": "󰌪"
        }
    },
    "custom/screenshot": {
        "format": "󰄀",
        "tooltip-format": "Captura de tela\nClique: recortar área\nBotão direito: tela inteira\nBotão do meio: janela",
        "on-click": "hyprshot -m region -o ~/Pictures/Screenshots",
        "on-click-right": "hyprshot -m output -m active -o ~/Pictures/Screenshots",
        "on-click-middle": "hyprshot -m window -o ~/Pictures/Screenshots"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mudo",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "backlight": {
        "format": "󰃠 {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{essid}\n{ifname}: {ipaddr}/{cidr}\nSinal: {signalStrength}%",
        "on-click": "ghostty -e nmtui"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "echo -e 'Bloquear\\nSuspender\\nReiniciar\\nDesligar\\nSair' | wofi --dmenu -p 'Energia' | xargs -I{} sh -c 'case {} in Bloquear) loginctl lock-session;; Suspender) systemctl suspend;; Reiniciar) systemctl reboot;; Desligar) systemctl poweroff;; Sair) hyprctl dispatch \"hl.dsp.exit()\";; esac'"
    }
}
