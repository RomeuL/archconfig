{
    // Configuração compartilhada entre as barras; config.jsonc seleciona cada monitor.
    // Altura, margens e rótulos dos workspaces vêm do tema atual (template em
    // ~/.config/theme/templates/waybar.jsonc.tpl); o que estiver aqui tem prioridade
    "include": ["~/.config/theme/current/waybar.jsonc"],
    "layer": "top",
    "position": "top",

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "fixed-center": true,
    "modules-right": ["group/agents", "group/system"],

    "group/agents": {
        "orientation": "horizontal",
        "modules": ["custom/codex", "custom/claude"]
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": ["custom/notification", "custom/screenshot", "tray", "pulseaudio", "backlight", "network", "bluetooth", "cpu", "memory", "power-profiles-daemon", "battery", "custom/power"]
    },

    "hyprland/workspaces": {
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    // Status do Claude Code e do Codex: um único agents.py (daemon) grava o estado e cada módulo só faz tail -F
    "custom/codex": {
        "exec": "sh -c '~/.config/waybar/scripts/agents.py daemon & exec tail -n1 -F ~/.cache/agent-status/waybar-codex.json 2>/dev/null'",
        "return-type": "json",
        "escape": false,
        "on-click": "~/.config/waybar/scripts/agents.py focus codex"
    },
    "custom/claude": {
        "exec": "sh -c '~/.config/waybar/scripts/agents.py daemon & exec tail -n1 -F ~/.cache/agent-status/waybar-claude.json 2>/dev/null'",
        "return-type": "json",
        "escape": false,
        "on-click": "~/.config/waybar/scripts/agents.py focus claude"
    },
    "hyprland/language": {
        "format": "⌨ {short}"
    },
    "clock": {
        "format": "{:%d/%m/%Y  %H:%M}",
        "format-alt": "{:%A, %d de %B de %Y  %H:%M}",
        "locale": "pt_BR.UTF-8",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#7aa2f7'><b><u>{}</u></b></span>"
            }
        }
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Perfil de energia: {profile}\nClique para alternar",
        "tooltip": true,
        "format-icons": {
            "default": "󰊚",
            "performance": "󰓅",
            "balanced": "󰊚",
            "power-saver": "󰌪"
        }
    },
    // Central de notificações (swaync): as notificações nunca aparecem sozinhas, ficam guardadas
    // aqui; o sino ganha um selo quando chega alguma
    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫", "none": "󰂚",
            "dnd-notification": "󱅫", "dnd-none": "󰂛",
            "inhibited-notification": "󱅫", "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󱅫", "dnd-inhibited-none": "󰂛"
        },
        "tooltip-format": "Notificações\nClique: abrir/fechar\nBotão direito: limpar tudo",
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -C -sw",
        "escape": true
    },
    "custom/screenshot": {
        "format": "󰄀",
        "tooltip-format": "Captura de tela\nClique: recortar área\nBotão direito: tela inteira\nBotão do meio: janela",
        "on-click": "hyprshot -m region -o ~/Pictures/Screenshots",
        "on-click-right": "hyprshot -m output -m active -o ~/Pictures/Screenshots",
        "on-click-middle": "hyprshot -m window -o ~/Pictures/Screenshots"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mudo",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "backlight": {
        "format": "󰃠 {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{essid}\n{ifname}: {ipaddr}/{cidr}\nSinal: {signalStrength}%",
        "on-click": "ghostty -e nmtui"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.local/bin/power-menu"
    }
}
