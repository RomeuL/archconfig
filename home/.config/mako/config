# Layout das notificações (estilo do swaync do Cyber-Arch); as cores vêm do tema atual
font=JetBrainsMono Nerd Font 11
border-size=2
border-radius=15
padding=12
margin=10
width=360
default-timeout=5000
# Cores geradas pelo theme-set. O mako só aceita include fora das seções, então fica por último.
include=~/.config/theme/current/mako.ini

[urgency=critical]
default-timeout=0
