# Cores das notificações no tema {{ theme_title }} (gerado pelo theme-set a partir de
# ~/.config/theme/templates/mako.ini.tpl: edite o template, não este arquivo)
background-color={{ background }}bf
text-color={{ foreground }}
border-color={{ accent }}
progress-color=over {{ selection }}

[urgency=low]
border-color={{ muted }}

[urgency=critical]
border-color={{ alert }}
text-color={{ alert }}
