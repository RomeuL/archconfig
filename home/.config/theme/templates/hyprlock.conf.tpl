# Cores, fonte e cantos da tela de bloqueio no tema {{ theme_title }} (gerado pelo theme-set a partir de
# ~/.config/theme/templates/hyprlock.conf.tpl: edite o template, não este arquivo)
$foreground = rgb({{ foreground_strip }})
$accent     = rgb({{ accent_strip }})
$active     = rgb({{ active_strip }})
$alert      = rgb({{ alert_strip }})
$font       = {{ font }}
$rounding   = {{ rounding }}
$lock_blur  = {{ lock_blur }}
$field_bg   = rgba({{ background_rgb }}, {{ lock_field_opacity }})
