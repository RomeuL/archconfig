/* Cores do tema {{ theme_title }} para o Waybar, o wofi e a tela de login (gerado pelo theme-set a partir de
   ~/.config/theme/templates/colors.css.tpl: edite o template, não este arquivo) */
@define-color foreground {{ foreground }};
@define-color background {{ background }};
@define-color surface    {{ lighter_background }};
@define-color accent     {{ accent }};
@define-color active     {{ active }};
@define-color highlight  {{ highlight }};
@define-color alert      {{ alert }};
@define-color good       {{ green }};
@define-color muted      {{ muted }};
