// Waybar do Tron Arcade: barra de ponta a ponta, colada no topo, e workspaces numerados
// como fases de fliperama (substitui ~/.config/theme/templates/waybar.jsonc.tpl)
{
    "height": 34,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "01", "2": "02", "3": "03", "4": "04", "5": "05",
            "6": "06", "7": "07", "8": "08", "9": "09", "10": "10",
            "z": "Z", "x": "X",
            "default": "··"
        }
    }
}
