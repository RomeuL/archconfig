{
    // Explorador de arquivos (barra lateral principal) do lado direito
    "workbench.sideBar.location": "right",

    // Barra lateral secundária (chat/IA) sempre começa fechada
    "workbench.secondarySideBar.defaultVisibility": "hidden",

    // Desliga o chat e os recursos de IA embutidos do editor
    "chat.disableAIFeatures": true,

    // Mesmo tema do sistema: a extensão local "Tema do Sistema" recebe as cores do theme-set e o
    // Code troca sozinho (escuro/claro segue o modo do sistema)
    "workbench.colorTheme": "Tema do Sistema",
    "window.autoDetectColorScheme": true,
    "workbench.preferredDarkColorTheme": "Tema do Sistema",
    "workbench.preferredLightColorTheme": "Tema do Sistema (claro)",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    // Terminal integrado sempre em zsh (mesmo se o Code for aberto por algo que ainda tenha SHELL=bash)
    "terminal.integrated.defaultProfile.linux": "zsh",
    "editor.cursorBlinking": "phase",
    "editor.bracketPairColorization.enabled": true,

    // Não destacar acentos do português (ã, ç, é...) como caracteres suspeitos
    "editor.unicodeHighlight.nonBasicASCII": false,
    "files.autoSave": "afterDelay"
}
