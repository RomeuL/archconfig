theme = __HOME__/.config/theme/current/ghostty.conf
background-opacity = 1.0
window-padding-x = 8
window-padding-y = 6
window-decoration = false
confirm-close-surface = false
# Sem o aviso "Reloaded the configuration" a cada troca de tema (theme-set recarrega o Ghostty)
app-notifications = no-config-reload
shell-integration = zsh
command = /usr/bin/zsh
cursor-style = block
gtk-custom-css = __HOME__/.config/theme/current/ghostty-tabs.css
