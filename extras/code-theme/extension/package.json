{
	"name": "theme-picker",
	"displayName": "Tema do Sistema",
	"description": "Cores do tema atual do sistema (theme-set), trocadas sem recarregar o editor",
	"version": "1.0.0",
	"publisher": "romeu",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"label": "Tema do Sistema",
				"uiTheme": "vs-dark",
				"path": "./themes/system-color-theme.json",
				"_watch": true
			},
			{
				"label": "Tema do Sistema (claro)",
				"uiTheme": "vs",
				"path": "./themes/system-color-theme.json",
				"_watch": true
			}
		]
	}
}
